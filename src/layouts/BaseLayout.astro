---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import {
  THEMES,
  DEFAULT_DARK,
  DEFAULT_LIGHT,
  THEME_KEY,
  TERM_KEY,
  INTRO_KEY,
} from "../data/themes";
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  publishDate?: string;
  /** The page has a hero head; the nav head stays hidden until it scrolls away. */
  heroHead?: boolean;
}

const {
  title,
  description = "Luke DeWitt - Developer from Halifax, Nova Scotia",
  ogImage = "/images/luke-head.png",
  ogType = "website",
  publishDate,
  heroHead = false,
} = Astro.props;

const siteURL = Astro.site || "https://www.whatadewitt.com";
const canonicalURL = new URL(Astro.url.pathname, siteURL);

let ogImageURL = "";
try {
  if (ogImage && ogImage.startsWith("http")) {
    ogImageURL = ogImage;
  } else if (ogImage) {
    ogImageURL = new URL(ogImage, siteURL).toString();
  } else {
    ogImageURL = new URL("/images/luke-head.png", siteURL).toString();
  }
} catch (e) {
  ogImageURL = siteURL + "/images/luke-head.png";
}

const gtmId = import.meta.env.PUBLIC_GTM_ID;

const modes = Object.fromEntries(THEMES.map((t) => [t.id, t.mode]));
const boot = {
  modes,
  dark: DEFAULT_DARK,
  light: DEFAULT_LIGHT,
  themeKey: THEME_KEY,
  termKey: TERM_KEY,
  introKey: INTRO_KEY,
};
---

<!doctype html>
<html
  lang="en"
  data-theme={DEFAULT_DARK}
  data-mode="dark"
  data-term="off"
  class:list={["dark", { scrolled: !heroHead }]}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.toString()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:image" content={ogImageURL} />
    {
      publishDate && (
        <meta property="article:published_time" content={publishDate} />
      )
    }
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    {/* Set theme, mode and terminal state before first paint (no flash). */}
    <script is:inline define:vars={{ boot }}>
      var d = document.documentElement;
      var store = null;
      try {
        store = window.localStorage;
      } catch (e) {}
      var get = function (k) {
        try {
          return store && store.getItem(k);
        } catch (e) {
          return null;
        }
      };
      var theme = get(boot.themeKey);
      if (!theme) {
        // Carry over the old site's light/dark choice.
        var legacy = get("color-theme");
        if (legacy === "dark") theme = boot.dark;
        if (legacy === "light") theme = boot.light;
      }
      if (!boot.modes[theme]) {
        theme = window.matchMedia("(prefers-color-scheme: light)").matches
          ? boot.light
          : boot.dark;
      }
      d.dataset.theme = theme;
      d.dataset.mode = boot.modes[theme];
      d.classList.toggle("dark", boot.modes[theme] === "dark");
      d.dataset.term = get(boot.termKey) === "on" ? "on" : "off";
      // First homepage view this session: the name types itself out.
      try {
        if (!window.sessionStorage.getItem(boot.introKey)) {
          d.classList.add("type-intro");
        }
      } catch (e) {}
    </script>

    {/* GTM */}

    { gtmId &&
    <>
    <!-- Google Tag Manager -->
    <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','${gtmId}');`}></script>
    <!-- End Google Tag Manager -->
    </>
    }
  </head>
  <body>
    {/* GTM */}
		{ gtmId && (
		<noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		)}

    <SiteHeader />
    <main id="main" class="wrap">
      <slot />
    </main>
    <SiteFooter />

    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
