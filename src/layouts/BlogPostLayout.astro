---
export interface Props {
  title: string;
  date: string;
  slug: string;
  excerpt?: string;
  featuredImage?: string;
  featuredImageAlt?: string;
  featuredImagePosition?: string;
}

const {
  title,
  date,
  slug,
  excerpt,
  featuredImage,
  featuredImageAlt,
  featuredImagePosition,
} = Astro.props;
import BaseLayout from "./BaseLayout.astro";
import ShareButtons from "../components/ShareButtons.astro";
import Split from "../components/Split.astro";
import Cursor from "../components/Cursor.astro";
import { formatPostDate } from "../lib/posts";
---

<BaseLayout
  title={title + " | Dew Drops by Luke DeWitt | whatadewitt.com"}
  description={excerpt ? excerpt : title + " - A blog post by Luke DeWitt"}
  {...(featuredImage && { ogImage: featuredImage })}
  publishDate={date}
  ogType="article"
>
  <article class="post">
    <header class="page-head post__head">
      <p class="prompt-line">
        <span class="prompt">$</span> cd <span class="t-arg">~/dew-drops/{slug}</span>
      </p>
      <h1 class="post__title"><Split text={title} start={0} /><Cursor /></h1>
      <p class="post__meta">
        <time class="date" datetime={date}>{formatPostDate(date)}</time>
      </p>
      {excerpt && <p class="page-lede"><Split text={excerpt} start={60} /></p>}
    </header>

    {
      featuredImage && (
        <img
          class="post__image"
          src={featuredImage}
          alt={featuredImageAlt || title}
          style={`object-position: ${featuredImagePosition ?? "center"}`}
        />
      )
    }

    <div class="prose">
      <slot />
    </div>

    <footer class="post__foot">
      <ShareButtons title={title} url={Astro.url.href} />
      <a href="/dew-drops" class="text-link">← all drops</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 720px;
    padding-bottom: 96px;
  }

  .post__head {
    padding-bottom: 24px;
  }

  .post__title {
    margin: 0;
    font-size: clamp(34px, 5.5vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.035em;
    font-weight: 700;
    color: var(--ink);
    text-wrap: balance;
  }

  .post__meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--muted);
  }

  .post__image {
    display: block;
    width: 100%;
    height: clamp(200px, 40vw, 360px);
    object-fit: cover;
    margin-bottom: 40px;
    border-radius: 8px;
    border: 1px solid var(--line);
  }

  .post__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
</style>
