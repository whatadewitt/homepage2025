---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Split from "../../components/Split.astro";
import Cursor from "../../components/Cursor.astro";
import { getProjects } from "../../lib/entries";

const projects = await getProjects();
---

<BaseLayout title="Projects | Luke DeWitt">
  <header class="page-head">
    <p class="prompt-line">
      <span class="prompt">$</span> ls <span class="t-flag">-l</span>
      <span class="t-arg">~/projects</span>
    </p>
    <h1 class="page-title"><Split text="Projects" start={0} /><Cursor /></h1>
    <p class="page-lede">
      <Split
        text="Less of a portfolio, more a few things I’m proud to share."
        start={40}
      />
    </p>
  </header>

  <ul class="projects">
    {
      projects.map((p, i) => (
        <li>
          <a
            href={`/projects/${p.id}`}
            class:list={["project", { "project--text": !(p.data.thumbnail ?? p.data.image) }]}
          >
            {(p.data.thumbnail ?? p.data.image) && (
              <img
                class="project__image"
                src={p.data.thumbnail ?? p.data.image}
                alt=""
                loading={i < 2 ? "eager" : "lazy"}
                decoding="async"
                style={p.data.thumbnailPosition && `object-position: ${p.data.thumbnailPosition}`}
              />
            )}
            <span class="project__body">
              <span class="card__tag">{p.data.tag}</span>
              <span class="project__title">
                <Split text={p.data.title} start={80 + i * 60} />
              </span>
              <span class="project__desc">
                <Split text={p.data.summary} start={110 + i * 60} />
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .projects {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
    padding: 0 0 96px;
    list-style: none;
  }

  .project {
    display: grid;
    grid-template-columns: 1fr;
    overflow: hidden;
    border-radius: 8px;
    background: var(--surface);
    border: 1px solid var(--line);
    text-decoration: none;
    transition: border-color 150ms;
  }

  .project:hover {
    border-color: var(--accent);
  }

  .project__image {
    display: block;
    width: 100%;
    height: 180px;
    object-fit: cover;
    border-bottom: 1px solid var(--line);
  }

  .project__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
  }

  .project__title {
    font-size: 24px;
    font-weight: 600;
    line-height: 1.25;
    color: var(--ink);
  }

  .project:hover .project__title {
    color: var(--accent);
  }

  .project__desc {
    max-width: 640px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
  }

  @media (min-width: 760px) {
    .project {
      grid-template-columns: 260px 1fr;
    }

    /* No image: the text gets the whole row. */
    .project--text {
      grid-template-columns: 1fr;
    }

    .project__image {
      height: 100%;
      min-height: 170px;
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }
  }
</style>
