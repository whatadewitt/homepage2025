---
export interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;

// URL encode the parameters for sharing
const encodedTitle = encodeURIComponent(title);
const encodedUrl = encodeURIComponent(url);

const targets = [
  { label: "bluesky", name: "Bluesky", href: `https://bsky.app/intent/compose?text=${encodedTitle}%20${encodedUrl}` },
  { label: "linkedin", name: "LinkedIn", href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}` },
  { label: "threads", name: "Threads", href: `https://threads.net/intent/post?text=${encodedTitle}%20${encodedUrl}` },
  { label: "x", name: "X (Twitter)", href: `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}` },
  { label: "facebook", name: "Facebook", href: `https://www.facebook.com/sharer.php?u=${encodedUrl}` },
];
---

<div class="share">
  <span class="share__label">share:</span>
  <ul>
    {
      targets.map((t) => (
        <li>
          <a href={t.href} target="_blank" rel="noopener noreferrer" aria-label={`Share on ${t.name}`}>
            {t.label}
          </a>
        </li>
      ))
    }
    <li>
      <button type="button" data-copy-link>copy link</button>
      <span class="sr" role="status" data-copy-status></span>
    </li>
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy-link]").forEach((btn) => {
    const status = btn.parentElement?.querySelector("[data-copy-status]");
    const label = btn.textContent;
    let timer: number | undefined;

    const show = (text: string) => {
      btn.textContent = text;
      if (status) status.textContent = text;
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        btn.textContent = label;
        if (status) status.textContent = "";
      }, 2000);
    };

    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        show("copied ✓");
      } catch {
        show("copy failed");
      }
    });
  });
</script>

<style>
  .share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 16px;
    font-family: var(--font-mono);
    font-size: 14px;
  }

  .share__label {
    color: var(--muted);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a,
  button {
    display: inline-block;
    padding: 12px 0;
    border: 0;
    background: none;
    color: var(--accent);
    font: inherit;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  button:hover {
    text-decoration: underline;
  }
</style>
