---
import { THEMES } from "../data/themes";

const year = new Date().getFullYear();
---

<footer class="wrap">
  <div class="site-footer">
    <p>
      © {year} luke dewitt · theme:
      <span class="theme-name">
        {THEMES.map((t) => <span data-theme-name={t.id}>{t.name}</span>)}
      </span>
    </p>
    <ul>
      <li><a href="https://www.github.com/whatadewitt" target="_blank" rel="me noopener noreferrer">github</a></li>
      <li><a href="https://www.linkedin.com/in/lukedewitt/" target="_blank" rel="me noopener noreferrer">linkedin</a></li>
    </ul>
  </div>
</footer>

<style>
  footer {
    margin-top: auto;
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    padding: 24px 0 40px;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }

  p {
    margin: 0;
  }

  .theme-name {
    color: var(--accent);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-block;
    padding: 12px 0;
    color: var(--muted);
    text-underline-offset: 3px;
  }

  a:hover {
    color: var(--ink);
  }
</style>
