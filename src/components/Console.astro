---
// The terminal docked along the bottom in terminal mode: cd, ls, cat and
// open over the site's pages. Its title bar always shows; open raises the
// rest. Behavior lives in scripts/console.ts; open state is on <html>
// (.console-open), set before paint by BaseLayout.
---

<section id="console" class="console" aria-label="Terminal" data-console>
  <div class="console__bar" data-console-bar>
    <span class="console__title" data-console-title>visitor@whatadewitt: ~</span>
    <button
      type="button"
      class="console__toggle"
      aria-controls="console-body"
      aria-expanded="false"
      data-console-toggle
    >
      <span class="console__when-closed">open <span aria-hidden="true">↑</span></span>
      <span class="console__when-open">hide <span aria-hidden="true">↓</span></span>
    </button>
  </div>
  <div id="console-body" class="console__scroll" data-console-scroll>
    <div class="console__out" role="log" aria-live="polite" data-console-out></div>
    <form class="console__line" data-console-form>
      <label for="console-input" class="c-prompt" data-console-prompt>
        <span class="c-sh"><span class="c-host">visitor@whatadewitt:</span><span class="c-path">~</span>$</span><span class="c-cc">&gt;</span>
      </label>
      <input
        id="console-input"
        class="console__input"
        type="text"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="go"
        data-console-input
      />
    </form>
  </div>
</section>

<script>
  import "../scripts/console";
</script>

<style>
  :global(:root) {
    --console-h: clamp(240px, 42svh, 480px);
    --console-bar: 49px;
  }

  /* The terminal covers the bottom of the page (just its bar when it's
     down); leave room to scroll past. */
  :global(html[data-term="on"] body) {
    padding-bottom: var(--console-bar);
  }

  :global(html.console-open[data-term="on"] body) {
    padding-bottom: var(--console-h);
  }

  .console {
    position: fixed;
    inset: auto 0 0;
    z-index: 30;
    height: var(--console-h);
    display: flex;
    flex-direction: column;
    background: var(--surface);
    color: var(--ink);
    border-top: 1px solid var(--line);
    box-shadow: 0 -12px 40px rgb(0 0 0 / 0.3);
    font: 400 15px/1.6 var(--font-mono);
    visibility: hidden;
    transform: translateY(100%);
  }

  /* In terminal mode the bar peeks up from the bottom; open raises the rest. */
  :global(html[data-term="on"]) .console {
    visibility: visible;
    transform: translateY(calc(100% - var(--console-bar)));
  }

  :global(html.console-open[data-term="on"]) .console {
    transform: none;
  }

  /* Slides only on a toggle, not when a page loads with it open. Height
     changes when doom takes the screen (.is-doom). */
  .console {
    transition: height 320ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  :global(html.console-anim) .console {
    transition:
      transform 220ms ease,
      visibility 0s,
      height 320ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* Leaving terminal mode: stay visible until it has slid away. */
  :global(html.console-anim[data-term="off"]) .console {
    transition:
      transform 220ms ease,
      visibility 0s 220ms,
      height 320ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .console,
    :global(html.console-anim) .console {
      transition: none;
    }
  }

  /* The `claude` easter egg (scripts/console.ts): orange, a > prompt. */
  .console {
    --claude: #D97757;
  }

  :global([data-mode="light"]) .console {
    --claude: #B4532F;
  }

  .c-cc {
    display: none;
    color: var(--claude);
  }

  .console.is-claude .c-sh {
    display: none;
  }

  .console.is-claude .c-cc {
    display: inline;
  }

  .console__out :global(.c-banner) {
    max-width: 56ch;
    margin: 4px 0 12px;
    padding: 8px 14px;
    border: 1px solid var(--claude);
    border-radius: 8px;
  }

  .console__out :global(.c-star) {
    color: var(--claude);
  }

  .console__out :global(.c-code) {
    color: var(--blue);
  }

  .console__out :global(.c-you) {
    margin-top: 12px;
    color: var(--muted);
  }

  /* Wrapped lines hang past the ⏺, like Claude Code. */
  .console__out :global(.c-reply) {
    margin-bottom: 4px;
    padding-left: 2ch;
    text-indent: -2ch;
  }

  /* doom: the terminal grows to the whole screen (.is-doom), then the game,
     an iframe (pages/doom), replaces the scrollback (.is-playing). */
  .console.is-doom {
    height: 100vh;
    height: 100dvh;
  }

  .console.is-playing .console__scroll {
    display: none;
  }

  .console :global(.console__game) {
    flex: 1;
    width: 100%;
    border: 0;
    background: #000;
  }

  .console__bar {
    flex: none;
    box-sizing: border-box;
    height: var(--console-bar);
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 6px 0 16px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 13px;
  }

  /* Down, the whole bar opens it. */
  :global(html:not(.console-open)) .console__bar {
    cursor: pointer;
  }

  .console__title {
    margin-right: auto;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .console__toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    color: var(--ink);
    font: 500 13px var(--font-mono);
    cursor: pointer;
  }

  .console__toggle:hover {
    border-color: var(--muted);
  }

  .console__when-open,
  :global(html.console-open) .console__when-closed {
    display: none;
  }

  :global(html.console-open) .console__when-open {
    display: inline;
  }

  .console__scroll {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 12px 16px 20px;
    cursor: text;
  }

  .console__line {
    display: flex;
    gap: 1ch;
  }

  .console__input {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    outline: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    caret-color: var(--accent);
  }

  /* Output is built by the script, so it's styled globally under .console. */
  .console :global(.c-prompt) {
    white-space: nowrap;
    color: var(--prompt);
  }

  .console :global(.c-path) {
    color: var(--blue);
  }

  .console__out > :global(*) {
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .console__out :global(.c-err) {
    color: var(--red);
  }

  .console__out :global(.c-muted) {
    color: var(--muted);
  }

  .console__out :global(.c-title) {
    font-weight: 600;
  }

  .console__out :global(.c-meta) {
    color: var(--yellow);
  }

  .console__out :global(.c-body) {
    margin-top: 1.6em;
  }

  .console__out :global(.c-ls) {
    display: flex;
    flex-wrap: wrap;
    gap: 0 3ch;
  }

  .console__out :global(.c-long) {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 3ch;
  }

  .console__out :global(.c-long > .c-muted) {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .console__out :global(.c-dir),
  .console__out :global(.c-file),
  .console__out :global(.c-run) {
    justify-self: start;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }

  .console__out :global(.c-dir) {
    color: var(--blue);
    font-weight: 600;
  }

  .console__out :global(.c-file) {
    color: var(--cyan);
    text-decoration: none;
  }

  .console__out :global(.c-run) {
    color: var(--accent);
    text-decoration: underline dotted;
    text-underline-offset: 3px;
  }

  .console__out :global(.c-dir:hover),
  .console__out :global(.c-file:hover) {
    text-decoration: underline;
  }

  /* The title bar already says who and where. */
  @media (max-width: 639px) {
    .console :global(.c-host) {
      display: none;
    }

    /* Under 16px, iOS zooms the page when the input takes focus. */
    .console__input {
      font-size: 16px;
    }
  }
</style>
