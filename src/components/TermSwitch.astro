---
// The ">_ full terminal" switch. Its knob position reads from html[data-term],
// so it's right on first paint; site.ts keeps aria-checked in sync.
---

<button
  type="button"
  role="switch"
  aria-checked="false"
  class="ctrl term-switch"
  data-term-switch
>
  <span class="term-switch__track" aria-hidden="true">
    <span class="term-switch__knob"></span>
  </span>
  <span aria-hidden="true">&gt;_</span><span class="hide-sm">full terminal</span>
</button>

<style>
  .term-switch {
    padding-left: 8px;
    gap: 6px;
  }

  .term-switch__track {
    position: relative;
    flex: 0 0 40px;
    width: 40px;
    height: 22px;
    border-radius: 999px;
    background: var(--line);
    transition: background-color 180ms;
  }

  .term-switch__knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--muted);
    transition:
      transform 180ms ease,
      background-color 180ms;
  }

  :global([data-term="on"]) .term-switch__track {
    background: var(--accent);
  }

  :global([data-term="on"]) .term-switch__knob {
    transform: translateX(18px);
    background: var(--on-accent);
  }
</style>
